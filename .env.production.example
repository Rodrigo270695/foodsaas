# =============================================================================
# FoodSaaS — PLANTILLA PRODUCCIÓN (Orvae + tenant demo)
# =============================================================================
# Copia en el servidor como .env. NO subas secretos reales a git.
#
# DNS recomendado:
#   Panel plataforma:     https://foodsaas.orvae.pe
#   Restaurantes:         https://{slug}.foodsaas.orvae.pe
#   Demo (primer oferta): https://demo.foodsaas.orvae.pe
#   API Orvae:            https://foodsaas.orvae.pe/api/internal/saas/provision
# =============================================================================

APP_NAME=FoodSaaS
APP_ENV=production
APP_KEY=                           # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://foodsaas.orvae.pe

APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

PLATFORM_SUPERADMIN_NAME="Super administrador"
PLATFORM_SUPERADMIN_PASSWORD=       # solo seed inicial

# Mismo valor en Orvae: FOODSAAS_PROVISION_HMAC_SECRET (o ORVAE_PROVISION_HMAC_SECRET compartido)
ORVAE_PROVISION_HMAC_SECRET=        # openssl rand -hex 32
ORVAE_PROVISION_MAX_SKEW_SECONDS=300
ORVAE_PROVISION_IDEMPOTENCY_TTL_DAYS=30

FOODSAAS_TENANT_SCHEME=https
FOODSAAS_TENANT_DOMAIN=foodsaas.orvae.pe
FOODSAAS_TENANT_LOGIN_PATH=/login
FOODSAAS_BOOTSTRAP_TTL_HOURS=48

# Demo pública (Sales Hub / landing Orvae lee GET /api/internal/saas/salesbot-knowledge)
FOODSAAS_DEMO_URL=https://demo.foodsaas.orvae.pe/login
FOODSAAS_DEMO_EMAIL=                # admin del tenant demo
FOODSAAS_DEMO_PASSWORD=             # opcional en knowledge; mejor bootstrap one-shot
FOODSAAS_REGISTER_URL=https://orvae.pe/software/foodsaas

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=foodsaas
DB_USERNAME=foodsaas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@foodsaas.orvae.pe
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

TENANT_CENTRAL_DOMAINS=foodsaas.orvae.pe
TENANT_ROOT_DOMAIN=foodsaas.orvae.pe
TENANT_SCHEMA_PREFIX=rest_
TENANT_CACHE_TTL=300

SESSION_TABLE=public.sessions
DB_CACHE_TABLE=public.cache
DB_CACHE_LOCK_TABLE=public.cache_locks
